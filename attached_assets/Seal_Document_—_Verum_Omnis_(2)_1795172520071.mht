@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: "Segoe UI", system-ui, -apple-system, sans-serif; background: rgb(4, 13, 27); color: rgb(213, 216, 221); min-height: 100vh; }

.container { max-width: 900px; margin: 0px auto; padding: 40px 20px; }

.topnav { position: fixed; top: 0px; left: 0px; right: 0px; z-index: 50; background: rgba(4, 13, 27, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(26, 46, 82, 0.5); height: 64px; }

.topnav-inner { max-width: 1200px; margin: 0px auto; height: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0px clamp(1.5rem, 5vw, 4rem); }

.topnav-logo { display: flex; align-items: center; gap: 2px; text-decoration: none; }

.topnav-logo img { height: 40px; width: auto; object-fit: contain; }

.topnav-links { display: flex; align-items: center; gap: 32px; }

.topnav-links a { font-family: "Courier New", monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: rgb(74, 126, 199); text-decoration: none; transition: color 0.3s; }

.topnav-links a:hover { color: rgb(248, 249, 250); }

.topnav-links a.active { color: rgb(212, 168, 67); }

.topnav-cta { display: flex; align-items: center; gap: 12px; }

.topnav-cta a { font-family: "Courier New", monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none; transition: 0.3s; border-radius: 6px; }

.cta-outline { padding: 10px 20px; border: 1px solid rgb(74, 126, 199); color: rgb(74, 126, 199); }

.cta-outline:hover { border-color: rgb(212, 168, 67); color: rgb(212, 168, 67); }

.cta-gold { padding: 10px 20px; background: rgb(212, 168, 67); color: rgb(4, 13, 27); font-weight: 600; }

.cta-gold:hover { background: rgb(232, 197, 103); box-shadow: rgba(212, 168, 67, 0.3) 0px 0px 20px; }

@media (max-width: 768px) {
  .topnav-links, .topnav-cta { display: none; }
}

.le-banner { background: linear-gradient(135deg, rgba(74, 126, 199, 0.15), rgba(212, 168, 67, 0.1)); border: 2px solid rgb(74, 126, 199); border-radius: 12px; padding: 24px 32px; margin: 0px 0px 40px; text-align: center; box-shadow: rgba(74, 126, 199, 0.15) 0px 4px 24px; }

.le-banner-title { font-family: "Courier New", monospace; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: rgb(34, 197, 94); margin-bottom: 8px; }

.le-banner-subtitle { font-size: 14px; color: rgb(213, 216, 221); line-height: 1.6; }

.le-banner-subtitle strong { color: rgb(248, 249, 250); font-weight: 600; }

.header { text-align: center; margin: 80px 0px 40px; }

.header .logo-main { margin: 0px auto 24px; max-width: min(360px, 70vw); height: auto; filter: drop-shadow(rgba(74, 126, 199, 0.2) 0px 0px 40px); }

.header .label { font-family: "Courier New", monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.15em; color: rgb(212, 168, 67); margin-bottom: 16px; }

.header h1 { font-family: "Cormorant Garamond", Georgia, serif; font-size: clamp(2rem, 6vw, 3.5rem); font-weight: 300; color: rgb(248, 249, 250); letter-spacing: -0.03em; line-height: 1.1; }

.header p { font-size: 1.125rem; color: rgb(213, 216, 221); margin-top: 12px; line-height: 1.7; max-width: 600px; margin-left: auto; margin-right: auto; }

.upload-zone { border: 2px dashed rgb(26, 46, 82); border-radius: 16px; padding: 60px 40px; text-align: center; cursor: pointer; transition: 0.3s; background: rgba(15, 52, 96, 0.08); margin-bottom: 30px; }

.upload-zone:hover { border-color: rgb(212, 168, 67); background: rgba(15, 52, 96, 0.2); }

.upload-zone.dragover { border-color: rgb(212, 168, 67); background: rgba(212, 168, 67, 0.08); }

.upload-zone .icon { font-size: 48px; margin-bottom: 16px; }

.upload-zone h3 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 24px; color: rgb(248, 249, 250); margin-bottom: 8px; font-weight: 400; }

.upload-zone p { font-size: 14px; color: rgb(74, 126, 199); }

.upload-zone input[type="file"] { display: none; }

.file-info { display: none; margin-bottom: 20px; padding: 16px; background: rgba(15, 52, 96, 0.12); border-radius: 10px; font-size: 14px; border: 1px solid rgba(26, 46, 82, 0.5); }

.file-info.visible { display: block; }

.seal-type { display: flex; gap: 12px; margin-bottom: 30px; justify-content: center; }

.seal-type button { padding: 14px 32px; border: 1px solid rgb(26, 46, 82); border-radius: 10px; background: transparent; color: rgb(74, 126, 199); font-size: 15px; cursor: pointer; transition: 0.3s; font-family: "Segoe UI", system-ui, sans-serif; }

.seal-type button.active { border-color: rgb(212, 168, 67); background: rgba(212, 168, 67, 0.1); color: rgb(212, 168, 67); }

.seal-type button:hover:not(.active) { border-color: rgb(74, 126, 199); color: rgb(248, 249, 250); }

.client-field { display: none; margin-bottom: 30px; }

.client-field.visible { display: block; }

.client-field label { display: block; color: rgb(74, 126, 199); margin-bottom: 8px; font-family: "Courier New", monospace; text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px; }

.client-field input { width: 100%; padding: 14px 18px; border: 1px solid rgb(26, 46, 82); border-radius: 10px; background: rgba(15, 52, 96, 0.15); color: rgb(248, 249, 250); font-size: 15px; font-family: inherit; }

.client-field input:focus { outline: none; border-color: rgb(212, 168, 67); }

.client-field input::placeholder { color: rgb(74, 126, 199); opacity: 0.6; }

.seal-btn { width: 100%; padding: 18px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; background: linear-gradient(135deg, rgb(212, 168, 67) 0%, rgb(184, 148, 42) 100%); color: rgb(4, 13, 27); font-size: 16px; font-weight: 700; cursor: pointer; transition: 0.3s; font-family: inherit; margin-bottom: 30px; text-transform: uppercase; letter-spacing: 0.05em; }

.seal-btn:hover { transform: translateY(-2px); box-shadow: rgba(212, 168, 67, 0.3) 0px 8px 30px; }

.seal-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

.pipeline { display: none; margin-bottom: 30px; }

.pipeline.visible { display: block; }

.pipeline h3 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 20px; color: rgb(212, 168, 67); margin-bottom: 20px; font-weight: 400; }

.step { display: flex; align-items: center; gap: 12px; padding: 14px 0px; border-bottom: 1px solid rgba(26, 46, 82, 0.5); font-size: 14px; }

.step:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.step .status { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; }

.step .status.pending { border: 2px solid rgb(26, 46, 82); color: rgb(74, 126, 199); }

.step .status.processing { border: 2px solid rgb(212, 168, 67); color: rgb(212, 168, 67); animation: 1.5s ease 0s infinite normal none running pulse; }

.step .status.complete { background: rgb(34, 197, 94); border: 2px solid rgb(34, 197, 94); color: rgb(4, 13, 27); }

.step .status.error { background: rgb(239, 68, 68); border: 2px solid rgb(239, 68, 68); color: rgb(255, 255, 255); }

@keyframes pulse { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.step .label { color: rgb(213, 216, 221); }

.step .label strong { color: rgb(248, 249, 250); }

.step .detail { margin-left: auto; font-size: 11px; color: rgb(74, 126, 199); font-family: "Courier New", monospace; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.results { display: none; background: rgba(15, 52, 96, 0.08); border: 1px solid rgba(26, 46, 82, 0.5); border-radius: 16px; padding: 30px; }

.results.visible { display: block; }

.results h3 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 24px; color: rgb(212, 168, 67); margin-bottom: 20px; font-weight: 400; }

.hash-row { margin-bottom: 16px; }

.hash-row label { display: block; font-size: 11px; color: rgb(74, 126, 199); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.08em; font-family: "Courier New", monospace; }

.hash-display { background: rgba(4, 13, 27, 0.6); border-radius: 10px; padding: 16px; font-family: "Courier New", monospace; font-size: 12px; color: rgb(34, 197, 94); word-break: break-all; border: 1px solid rgba(26, 46, 82, 0.5); }

.qr-section { text-align: center; margin: 24px 0px; }

#qrPreview { max-width: 200px; border-radius: 12px; background: white; padding: 16px; }

.qr-section p { font-size: 12px; color: rgb(74, 126, 199); margin-top: 10px; }

.mode-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

@media (max-width: 640px) {
  .mode-grid { grid-template-columns: 1fr; }
}

.mode-card { text-align: left; cursor: pointer; font-family: inherit; background: rgba(15, 52, 96, 0.08); border: 1px solid rgba(26, 46, 82, 0.5); border-radius: 12px; padding: 16px; transition: 0.25s; }

.mode-card strong { display: block; font-size: 14px; color: rgb(248, 249, 250); margin-bottom: 6px; }

.mode-card span { font-size: 12px; color: rgb(148, 163, 184); line-height: 1.6; }

.mode-card.active { border-color: rgb(212, 168, 67); background: rgba(212, 168, 67, 0.08); box-shadow: rgb(212, 168, 67) 0px 0px 0px 1px inset; }

.mode-card.active strong { color: rgb(212, 168, 67); }

.ots-status { display: flex; align-items: center; gap: 8px; padding: 14px; border-radius: 10px; margin-bottom: 20px; font-size: 13px; }

.ots-status.pending { background: rgba(212, 168, 67, 0.08); border: 1px solid rgba(212, 168, 67, 0.25); color: rgb(212, 168, 67); }

.ots-status.complete { background: rgba(34, 197, 94, 0.08); border: 1px solid rgba(34, 197, 94, 0.25); color: rgb(34, 197, 94); }

.ots-status.error { background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); color: rgb(239, 68, 68); }

.preview-section { margin: 20px 0px; padding: 20px; background: rgba(4, 13, 27, 0.4); border-radius: 12px; border: 1px solid rgba(26, 46, 82, 0.5); }

.preview-section h4 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 18px; color: rgb(212, 168, 67); margin-bottom: 12px; font-weight: 400; }

.preview-section p { font-size: 13px; color: rgb(213, 216, 221); line-height: 1.7; }

.preview-section p strong { color: rgb(248, 249, 250); }

.verify-link { display: block; text-align: center; padding: 14px; background: rgba(15, 52, 96, 0.15); border-radius: 10px; color: rgb(212, 168, 67); text-decoration: none; font-size: 14px; margin-bottom: 16px; border: 1px solid rgba(26, 46, 82, 0.5); transition: 0.3s; }

.verify-link:hover { background: rgba(15, 52, 96, 0.3); border-color: rgb(212, 168, 67); }

.download-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }

.download-btn { display: block; padding: 16px; border-radius: 10px; text-align: center; text-decoration: none; font-size: 14px; font-weight: 600; transition: 0.3s; cursor: pointer; border: 1px solid rgb(212, 168, 67); background: rgba(212, 168, 67, 0.08); color: rgb(212, 168, 67); }

.download-btn:hover { background: rgba(212, 168, 67, 0.15); }

.download-btn.primary { background: linear-gradient(135deg, rgb(212, 168, 67) 0%, rgb(184, 148, 42) 100%); color: rgb(4, 13, 27); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.download-btn.primary:hover { background: rgb(232, 197, 103); }

.info-section { margin-top: 60px; padding-top: 40px; border-top: 1px solid rgba(26, 46, 82, 0.5); }

.info-section h3 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 28px; color: rgb(212, 168, 67); margin-bottom: 16px; font-weight: 400; }

.info-section > p { font-size: 16px; color: rgb(213, 216, 221); line-height: 1.7; margin-bottom: 24px; }

.info-section .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

.info-section .grid .item { background: rgba(15, 52, 96, 0.08); border-radius: 12px; padding: 24px; border: 1px solid rgba(26, 46, 82, 0.4); }

.info-section .grid .item h4 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 18px; color: rgb(212, 168, 67); margin-bottom: 10px; font-weight: 500; }

.info-section .grid .item p { font-size: 13px; color: rgb(74, 126, 199); margin: 0px; line-height: 1.6; }

.site-footer { margin-top: 60px; padding-top: 30px; border-top: 1px solid rgba(26, 46, 82, 0.5); text-align: center; font-size: 12px; color: rgb(74, 126, 199); font-family: "Courier New", monospace; text-transform: uppercase; letter-spacing: 0.08em; line-height: 2; }

@media (max-width: 600px) {
  .info-section .grid, .download-grid { grid-template-columns: 1fr; }
  .header h1 { font-size: 2.2rem; }
}
